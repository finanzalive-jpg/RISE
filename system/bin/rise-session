#!/bin/sh
# Rise – avvia la sessione grafica e la fa ripartire da sola se si chiude per un errore.
# labwc gestisce le finestre e avvia rise-shell (vedi /etc/xdg/labwc/autostart).
LOG=/tmp/rise-session.log

# --- Desktop di Rise (Cinnamon, veloce e collaudato) -----------------------------------------
# Se non parte (due chiusure di fila nel primo minuto) si passa al desktop classico di Rise qui sotto.
CFG="$HOME/.config/rise"
if [ ! -f "$CFG/desktop-classico" ] && command -v cinnamon-session >/dev/null 2>&1 && command -v startx >/dev/null 2>&1; then
  xfails=0
  while [ "$xfails" -lt 2 ]; do
    [ -f /tmp/rise-x.log ] && mv -f /tmp/rise-x.log /tmp/rise-x.log.prima
    start=$(date +%s)
    startx /usr/local/bin/rise-xsession -- :0 "vt${XDG_VTNR:-1}" -keeptty -nolisten tcp >/tmp/rise-x.log 2>&1
    code=$?
    echo "$(date '+%F %T') desktop chiuso (codice $code)" >> /tmp/rise-crash.log
    if [ $(( $(date +%s) - start )) -lt 60 ]; then xfails=$((xfails + 1)); else xfails=0; fi
    sleep 1
  done
  echo "$(date '+%F %T') il desktop non parte: passo al desktop classico" >> /tmp/rise-crash.log
fi

# --- Desktop classico di Rise (labwc) ---------------------------------------------------------
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
# Se manca una scheda video con accelerazione (es. macchine virtuali), disegna via software.
export WLR_RENDERER_ALLOW_SOFTWARE=1
if systemd-detect-virt -q; then
  export WLR_NO_HARDWARE_CURSORS=1
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
fi

# Prudenza di base (schede video sconosciute, macchine virtuali): le pagine si disegnano senza memoria video
# condivisa e i video li decodifica il processore. Sulle schede Intel recenti (dal 2015) si usa tutta la
# grafica: disegno più veloce e video (YouTube…) decodificati dal chip, che consuma molto meno.
SAFE=1
for d in /sys/class/drm/card*/device; do
  [ "$(cat "$d/vendor" 2>/dev/null)" = "0x8086" ] || continue
  case "$(cat "$d/device" 2>/dev/null)" in
    # Intel di 2ª-4ª generazione (circa 2011-2015): la grafica 3D del browser può bloccarsi
    0x010*|0x011*|0x012*|0x015*|0x016*|0x040*|0x041*|0x042*|0x0a0*|0x0a1*|0x0a2*|0x0c0*|0x0c1*|0x0c2*|0x0d0*|0x0d1*|0x0d2*|0x0f3*)
      export RISE_SAFE_GPU=1
      export WEBKIT_DISABLE_COMPOSITING_MODE=1
      echo "scheda video Intel vecchia: modalità grafica prudente" ;;
    *) SAFE=0 ;;
  esac
done
systemd-detect-virt -q && SAFE=1
[ -f "$HOME/.config/rise/grafica-prudente" ] && SAFE=1
if [ "$SAFE" = 1 ]; then
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  export GST_PLUGIN_FEATURE_RANK="vaapidecodebin:NONE,vaapih264dec:NONE,vaapivp9dec:NONE,vaapivp8dec:NONE,vaapiav1dec:NONE,vah264dec:NONE,vah265dec:NONE,vavp8dec:NONE,vavp9dec:NONE,vaav1dec:NONE,nvh264dec:NONE,nvh265dec:NONE"
  export LIBVA_DRIVER_NAME=none
else
  echo "scheda video Intel recente: grafica e video accelerati"
fi

fails=0
while :; do
  # tiene il registro della sessione precedente per capire cosa è andato storto
  [ -f "$LOG" ] && mv -f "$LOG" "$LOG.prima"
  [ -f /tmp/rise-shell.log ] && mv -f /tmp/rise-shell.log /tmp/rise-shell.log.prima
  start=$(date +%s)
  # due chiusure di fila con la grafica accelerata: si torna alla modalità prudente (e la si ricorda)
  if [ "$fails" -ge 2 ] && [ "$SAFE" = 0 ]; then
    SAFE=1; mkdir -p "$HOME/.config/rise"; : > "$HOME/.config/rise/grafica-prudente"
    export WEBKIT_DISABLE_DMABUF_RENDERER=1 LIBVA_DRIVER_NAME=none
    echo "la sessione si è chiusa due volte: grafica prudente"
  fi
  if [ "$fails" -lt 3 ] && command -v labwc >/dev/null 2>&1; then
    labwc >"$LOG" 2>&1
  else
    # dopo 3 chiusure di fila: modalità semplice, una sola finestra a tutto schermo
    RISE_SINGLE=1 cage -s -- /usr/local/bin/rise-shell >"$LOG" 2>&1
  fi
  code=$?
  echo "$(date '+%F %T') sessione chiusa (codice $code)" >> /tmp/rise-crash.log
  if [ $(( $(date +%s) - start )) -lt 60 ]; then fails=$((fails + 1)); else fails=0; fi
  # se si chiude troppe volte anche in modalità semplice, aspetta un po' prima di riprovare
  [ "$fails" -gt 5 ] && sleep 10
  sleep 1
done
