# Rise – impostazioni predefinite del desktop (Cinnamon). Chi le cambia, tiene le sue.
[org.cinnamon]
enabled-applets=['panel1:left:0:menu@cinnamon.org', 'panel1:left:1:grouped-window-list@cinnamon.org', 'panel1:right:0:systray@cinnamon.org', 'panel1:right:1:xapp-status@cinnamon.org', 'panel1:right:2:notifications@cinnamon.org', 'panel1:right:3:removable-drives@cinnamon.org', 'panel1:right:4:keyboard@cinnamon.org', 'panel1:right:5:network@cinnamon.org', 'panel1:right:6:sound@cinnamon.org', 'panel1:right:7:power@cinnamon.org', 'panel1:right:8:calendar@cinnamon.org', 'panel1:right:9:cornerbar@cinnamon.org']
panels-enabled=['1:0:bottom']
panels-height=['1:44']
favorite-apps=['org.gnome.Epiphany.desktop', 'nemo.desktop', 'rise-assistant.desktop', 'rise-store.desktop', 'cinnamon-settings.desktop']
desktop-effects-workspace=false
startup-animation=false

[org.cinnamon.theme]
name='Rise'

[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/backgrounds/rise/rise-cielo.jpg'
picture-options='zoom'

[org.cinnamon.desktop.interface]
gtk-theme='Adwaita'
icon-theme='Papirus'
cursor-theme='Adwaita'
font-name='Noto Sans 10'
clock-show-date=true
gtk-overlay-scrollbars=false

[org.cinnamon.desktop.wm.preferences]
button-layout=':minimize,maximize,close'
titlebar-font='Noto Sans Bold 10'

[org.cinnamon.desktop.input-sources]
sources=[('xkb', 'it')]

[org.cinnamon.desktop.screensaver]
lock-enabled=false

[org.cinnamon.settings-daemon.plugins.power]
lock-on-suspend=false

[org.cinnamon.desktop.sound]
event-sounds=false

[org.cinnamon.sounds]
login-enabled=false
logout-enabled=false

[org.nemo.desktop]
computer-icon-visible=true
trash-icon-visible=true
home-icon-visible=false
volumes-visible=true

[org.nemo.preferences]
show-image-thumbnails='always'

[org.cinnamon.muffin]
placement-mode='center'

[org.gnome.Epiphany.state]
is-maximized=true
