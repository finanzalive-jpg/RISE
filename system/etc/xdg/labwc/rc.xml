<?xml version="1.0"?>
<!-- Rise – gestore delle finestre (labwc) -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
  </core>

  <placement><policy>cascade</policy></placement>

  <theme>
    <name>Rise</name>
    <cornerRadius>8</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow"><name>Onest</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Onest</name><size>10</size><weight>bold</weight></font>
    <font place="OnScreenDisplay"><name>Onest</name><size>11</size></font>
  </theme>

  <!-- Alt+Tab: elenco finestre con anteprima -->
  <windowSwitcher preview="yes" outlines="yes" allWorkspaces="no"><osd show="yes"/></windowSwitcher>

  <!-- Trascina una finestra sul bordo: si affianca a metà schermo; in alto: si ingrandisce -->
  <snapping>
    <range inner="10" outer="10"/>
    <overlay><enabled>yes</enabled></overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <focus><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>

  <keyboard>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>
    <!-- Tasto Windows: menu Start -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="rise-shell --start"/></keybind>
    <keybind key="Super_R" onRelease="yes"><action name="Execute" command="rise-shell --start"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="W-e"><action name="Execute" command="rise-shell --open files"/></keybind>
    <keybind key="W-i"><action name="Execute" command="rise-shell --open settings"/></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <keybind key="W-Up"><action name="Maximize"/></keybind>
    <keybind key="W-Down"><action name="Iconify"/></keybind>
    <keybind key="Print"><action name="Execute" command="sh -c 'mkdir -p ~/Immagini; grim ~/Immagini/Schermata-$(date +%Y%m%d-%H%M%S).png'"/></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="sh -c 'brightnessctl -q -c backlight set 5%+ || sudo -n brightnessctl -q -c backlight set 5%+'"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="sh -c 'brightnessctl -q -c backlight set 5%- || sudo -n brightnessctl -q -c backlight set 5%-'"/></keybind>
  </keyboard>

  <!-- Browser, video, ufficio: si aprono a tutto schermo (si può sempre rimpicciolire) -->
  <windowRules>
    <windowRule identifier="org.gnome.Epiphany*"><action name="Maximize"/></windowRule>
    <windowRule identifier="epiphany*"><action name="Maximize"/></windowRule>
    <windowRule identifier="google-chrome*"><action name="Maximize"/></windowRule>
    <windowRule identifier="com.google.Chrome*"><action name="Maximize"/></windowRule>
    <windowRule identifier="chromium*"><action name="Maximize"/></windowRule>
    <windowRule identifier="firefox*"><action name="Maximize"/></windowRule>
    <windowRule identifier="org.mozilla.firefox*"><action name="Maximize"/></windowRule>
    <windowRule identifier="libreoffice*"><action name="Maximize"/></windowRule>
    <windowRule identifier="org.inkscape.Inkscape*"><action name="Maximize"/></windowRule>
  </windowRules>

  <mouse>
    <default/>
    <!-- Niente menu "di sistema" sul desktop: il desktop è di Rise -->
    <context name="Root">
      <mousebind button="Left" action="Press"/>
      <mousebind button="Right" action="Press"/>
      <mousebind button="Middle" action="Press"/>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
  </libinput>
</labwc_config>
